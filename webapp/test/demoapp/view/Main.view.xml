<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	controllerName="fiori.shepherd.guide.demo.view.Main" displayBlock="true">
	<App id="app">
	<Page id="page" title="Manage Sales Orders">
		<subHeader>
			<OverflowToolbar>
				<SearchField id="searchField" width="20rem" placeholder="Search by customer or order" search=".onSearch"/>
				<SegmentedButton id="statusFilter" selectionChange=".onFilter">
					<items>
						<SegmentedButtonItem key="" text="All"/>
						<SegmentedButtonItem key="Open" text="Open"/>
						<SegmentedButtonItem key="In Process" text="In Process"/>
						<SegmentedButtonItem key="Completed" text="Completed"/>
					</items>
				</SegmentedButton>
				<ToolbarSpacer/>
				<Button text="Create" type="Emphasized" icon="sap-icon://add" press=".onCreate"/>
			</OverflowToolbar>
		</subHeader>
		<Table id="ordersTable" items="{/orders}">
			<columns>
				<Column><Text text="Order"/></Column>
				<Column><Text text="Customer"/></Column>
				<Column hAlign="End"><Text text="Net Amount"/></Column>
				<Column><Text text="Status"/></Column>
			</columns>
			<items>
				<ColumnListItem type="Navigation">
					<Text text="{id}"/>
					<Text text="{customer}"/>
					<ObjectNumber number="{amount}" unit="{currency}"/>
					<ObjectStatus text="{status}"/>
				</ColumnListItem>
			</items>
		</Table>
		<dependents>
			<Dialog id="createDialog" title="New Sales Order" contentWidth="24rem">
				<content>
					<VBox class="sapUiSmallMargin">
						<Label text="Customer" labelFor="newCustomer"/>
						<Input id="newCustomer"/>
						<Label text="Net Amount" labelFor="newAmount"/>
						<Input id="newAmount" type="Number"/>
					</VBox>
				</content>
				<beginButton><Button text="Save" type="Emphasized" press=".onCloseDialog"/></beginButton>
				<endButton><Button text="Cancel" press=".onCloseDialog"/></endButton>
			</Dialog>
		</dependents>
	</Page>
	</App>
</mvc:View>
