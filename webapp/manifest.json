{
  "_version": "1.42.0",
  "sap.app": {
    "id": "fiori.shepherd.guide",
    "type": "component",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "0.1.0" },
    "i18n": "i18n/i18n.properties",
    "crossNavigation": {
      "inbounds": {
        "Shell-plugin": {
          "semanticObject": "Shell",
          "action": "plugin",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" },
          "hideLauncher": true
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "componentName": "fiori.shepherd.guide",
    "contentDensities": { "compact": true, "cozy": true },
    "dependencies": {
      "minUI5Version": "1.84.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ushell": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "fiori.shepherd.guide.i18n.i18n" }
      }
    },
    "config": {
      "fioriGuide": {
        "toursUrl": "",
        "toursApiUrl": "https://n8n.teddybiere.info/webhook/fiori-guide",
        "autoStart": true,
        "showHeaderButton": true,
        "hideButtonWithoutTours": true,
        "showAllTours": true,
        "resumeMinutes": 30
      }
    }
  },
  "sap.flp": {
    "type": "plugin"
  }
}
